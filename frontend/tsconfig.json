{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // the SDK packages are linked from an ayon-frontend checkout: resolve their imports (React's
    // types) from this addon's node_modules, not the checkout's
    "preserveSymlinks": true,
    "baseUrl": "src",
    "paths": {
      "@containers/*": ["./containers/*"],
      "@hooks/*": ["./hooks/*"],
      "@components/*": ["./components/*"],
      "@api/*": ["./api/*"],
      "@api": ["./api"],
      "@types": ["./types"],
      "@queries/*": ["./services/*"],
      "@pages/*": ["./pages/*"],
      "@context/*": ["./context/*"],
      "@state/*": ["./features/*"],
      "@helpers/*": ["./helpers/*"],
      "@constants": ["./constants"],
      "@constants/*": ["./constants/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],

  "exclude": ["node_modules", "**/*.d.ts"]
}
