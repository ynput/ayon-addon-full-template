{
  "name": "ayon-addon-full-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-token": "node --env-file=.env.local ./gen/getAuth.js",
    "generate-gql": "cd gen && graphql-codegen --require dotenv/config",
