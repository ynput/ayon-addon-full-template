    "link-frontend": "node ./scripts/linkFrontend.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^8.0.0",
    "@module-federation/enhanced": "2.3.2",
    "@reduxjs/toolkit": "^2.7.0",
    "@rtk-query/graphql-request-base-query": "^2.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@ynput/ayon-addon": "link:.ayon-frontend/addon",
    "@ynput/ayon-frontend-shared": "^0.7.0",
    "@ynput/ayon-react-addon-provider": "^0.1.8",
    "@ynput/ayon-react-components": "^1.22.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "query-string": "^9.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.3.0",
    "react-toastify": "^9.0.3",
    "styled-components": "6.1.14"
